; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited manually if needed.

config_version=5

[application]

config/name="Zork: The Great Underground Empire"
config/description="A darkly comedic point-and-click adventure set in the Great Underground Empire."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
RoomManager="*res://scripts/autoload/room_manager.gd"
InventoryManager="*res://scripts/autoload/inventory_manager.gd"
NarratorManager="*res://scripts/autoload/narrator_manager.gd"
LightingManager="*res://scripts/autoload/lighting_manager.gd"
DeathManager="*res://scripts/autoload/death_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
ThiefManager="*res://scripts/autoload/thief_manager.gd"
HintManager="*res://scripts/autoload/hint_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"

[input]

interact={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(0,0),"global_position":Vector2(0,0),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)]
}
